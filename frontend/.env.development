# Profile: LOCAL  —  loaded by `npm run dev`
#
# Empty backend base keeps every request relative, so Vite's dev-server proxy
# forwards /auth and /api to DEV_PROXY_TARGET below. Because the browser only ever
# talks to localhost:5173, the refresh-token cookie stays same-site and needs no
# Secure / SameSite=None handling.
VITE_BACKEND_BASE=

# Where the dev-server proxy forwards to. Not VITE_-prefixed, so it is read by
# vite.config.js only and never reaches the browser bundle.
DEV_PROXY_TARGET=http://localhost:3000
