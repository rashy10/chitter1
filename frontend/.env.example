# Copy to frontend/.env.local and adjust. Vite only exposes VITE_-prefixed vars.

# Backend origin.
#
# DEVELOPMENT: leave this UNSET (or empty). Requests then stay relative and
# vite.config.js proxies /auth and /api to http://localhost:3000, so the
# refresh-token cookie stays same-site and needs no Secure/SameSite=None handling.
#
# PRODUCTION: set to the backend origin, e.g.
#   VITE_BACKEND_BASE=https://chitter-backend-app-4c5e1318fbab.herokuapp.com
VITE_BACKEND_BASE=
