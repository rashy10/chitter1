# Copy to backend/.env and fill in. Never commit the real file.
# This template must contain PLACEHOLDERS ONLY — it is tracked by git.

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
DB_NAME=twitter_clone

# --- Server ---
PORT=3000
NODE_ENV=development
# Allowed browser origins, comma-separated. Must be exact (scheme + host + port) —
# credentials: true forbids a '*' wildcard. Example for both dev and prod:
#   FRONTEND_ORIGIN=http://localhost:5173,https://chitter1.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<random-48-byte-base64url-string>
# Refresh token lifetime in days (default 7)
REFRESH_TOKEN_DAYS=7

# --- Email (SMTP) ---
# SMTP_PASS is an *app password*, not the account password.
# Legacy MAILTRAP_PASS / MAILTRAP_PORT are still read as fallbacks so existing
# deployments keep working; prefer the SMTP_* names below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<smtp-account@example.com>
SMTP_PASS=<smtp-app-password>

# --- S3 media uploads ---
AWS_BUCKET_NAME=<bucket-name>
AWS_BUCKET_REGION=<region>
AWS_ACCESS_KEY_ID=<access-key-id>
AWS_SECRET_ACCESS_KEY=<secret-access-key>
