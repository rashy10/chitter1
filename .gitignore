# --- Secrets ---
# Ignore every .env variant by default...
.env
.env.*
# ...but track the placeholder templates and the Vite mode files, which hold only
# non-secret public config (backend URLs, proxy targets). See docs/ENVIRONMENTS.md.
!.env.example
!.env.sample
!.env.development
!.env.remote
!.env.production
# Personal per-machine overrides always stay out of git. These rules come last so
# they win over the negations above.
.env.local
.env.*.local

# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
build/
*.tsbuildinfo

# --- Python venv ---
.venv/

# --- OS / editor cruft ---
.DS_Store
**/.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
